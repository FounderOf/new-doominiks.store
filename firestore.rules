rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- HELPER FUNCTIONS ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      // Tambahkan semua owner UID kamu di sini (harus sama dengan OWNER_UIDS di firebase-config.js)
      return request.auth.uid in ["YOUR_OWNER_UID"];
    }

    function isOwnerOrSelf(uid) {
      return isOwner() || request.auth.uid == uid;
    }

    // ---- PRODUCTS (read: public, write: owner only) ----
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // ---- ORDERS (read/create: authenticated user, update: owner or self) ----
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isOwner() || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    // ---- USERS (read: owner only, create/update: self) ----
    match /users/{userId} {
      allow read: if isOwnerOrSelf(userId);
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isOwner();
    }

    // ---- LEADERBOARD (read: public, write: authenticated) ----
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isOwner();
    }

    // ---- STATS (read: public, write: owner or authenticated increment) ----
    match /stats/{doc} {
      allow read: if true;
      allow write: if isOwner() || isSignedIn();
    }

    // ---- SETTINGS (read: public, write: owner only) ----
    match /settings/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
